# Copy to .env (local) or add as Replit Secrets. Never commit real values.
KRACKEDDEVS_API_KEY=       # KrackedDevs LLM proxy (GPT + DeepSeek). When set it replaces Gemini for every agent
KRACKEDDEVS_MODEL=gpt-5.5
KRACKEDDEVS_REVIEWER_MODEL=DeepSeek-V4-Pro
GEMINI_API_KEY=            # Google AI Studio key: models when KRACKEDDEVS_API_KEY is empty, plus web-search grounding
GEMINI_API_KEY_2=          # optional second key, used when the first is rate-limited
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REVIEWER_MODEL=gemini-3.1-flash-lite
DATABASE_URL=              # PostgreSQL, e.g. the Supabase pooler string. Empty = embedded PGlite in ./data
# Replit-managed Clerk provisions CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY and VITE_CLERK_PUBLISHABLE_KEY.
# Do not set up or commit Supabase Auth credentials; Clerk sessions secure browser API requests.
SESSION_SECRET=             # required to sign private guest-profile cookies; use a random secret of at least 32 bytes
ADMIN_EMAILS=              # comma-separated: these signed-in users get the admin role (also advisor)
ADVISOR_EMAILS=            # comma-separated: advisor role (advisor approvals, HR redeployment view)
RUNPOD_API_KEY=            # optional: bge-m3 embeddings on RunPod Serverless
RUNPOD_EMBED_ENDPOINT_ID=
LOCAL_EMBED_URL=           # optional: local Infinity server with bge-m3, e.g. http://127.0.0.1:7997 (used if RunPod is not set)
LOCAL_EMBED_MODEL=         # optional, default BAAI/bge-m3 (RUNPOD_EMBED_MODEL likewise)
BRAVE_API_KEY=             # optional web search for the market scout
TAVILY_API_KEY=            # optional web search for the market scout
DEMO_MODE=false            # true = replay the last recorded run if a live source or the AI fails (labelled "replayed")
ADMIN_TOKEN=               # optional: x-admin-token header opens admin routes (scripts, tests); with no accounts and no token, admin routes are open
SCOUT_SCHEDULE=on          # off = no scheduled market scout
SCOUT_INTERVAL_HOURS=24
PORT=3000
EMBED_PROVIDER=auto        # runpod | local | gemini | none (auto = first configured)
