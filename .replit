run = "npm run dev"
entrypoint = "server/index.ts"
modules = ["web", "python-3.12", "nodejs-22"]

[deployment]
run = ["sh", "-c", "npm start"]
deploymentTarget = "vm"

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"
SCOUT_SCHEDULE = "on"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
